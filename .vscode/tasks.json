{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": ["build", "${workspaceFolder}/CyberHoops.sln"],
            "problemMatcher": "$msCompile",
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "test",
            "command": "dotnet",
            "type": "process",
            "args": ["test", "${workspaceFolder}/tests/CyberHoops.Tests/CyberHoops.Tests.csproj"],
            "problemMatcher": "$msCompile",
            "group": { "kind": "test", "isDefault": true }
        }
    ]
}
